# Server Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Database: pagepilot_poc)
# URL-encode any special characters in the Atlas password (e.g. @ -> %40)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pagepilot_poc?retryWrites=true&w=majority

# PagePilot API Credentials & Host
PAGEPILOT_EMAIL=<pagepilot-account-email>
PAGEPILOT_PASSWORD=<pagepilot-account-password>
PAGEPILOT_BASE_URL=https://pagepilot.fabbuilder.com
PAGEPILOT_APP_ID=6336128a251dcbda38bd8fe1

# Frontend Origin for CORS
CLIENT_URL=http://localhost:3000

# --- Optional: browser-side PagePilot AHDjs module (bonus) ---
# VITE_* values ARE shipped in the public JS bundle, so only public client
# identifiers belong here - never a password or token. Both are optional:
# client/src/lib/pagepilot.js falls back to these same defaults.
VITE_PAGEPILOT_APP_ID=6336128a251dcbda38bd8fe1
VITE_PAGEPILOT_API_HOST=https://pagepilot.fabbuilder.com
